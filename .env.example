# Copy to .env locally. These two values are public frontend configuration.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Use the sb_publishable_ key. Never use sb_secret_, service_role, or a
# database password here. Never commit .env or student records.
